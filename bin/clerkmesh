#!/usr/bin/env bash
# ClerkMesh launcher. Usage: clerkmesh init | primary --tui | web [--gate0-cert]
set -eu

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
CLERKMESH_ROOT=$(cd "$SCRIPT_DIR/.." && pwd -P)
export CLERKMESH_ROOT
export CLERKMESH_DATA="$CLERKMESH_ROOT/clerkmesh-data"
export CLERKMESH_STATE="$CLERKMESH_ROOT/clerkmesh-state"
export CLERKMESH_CLERKS="$CLERKMESH_ROOT/clerks"
export CLERKMESH_CACHE="$CLERKMESH_ROOT/cache"
export FM_ROOT_OVERRIDE="$CLERKMESH_ROOT/firstmate"
export FM_HOME="$CLERKMESH_ROOT/firstmate"
VERSION=1

fatal() { printf 'error: %s\n' "$*" >&2; exit 1; }

verify_provenance() {
  [ -d "$FM_HOME" ] || fatal "vendored Firstmate directory is missing"
  [ -f "$CLERKMESH_ROOT/firstmate.provenance.json" ] || fatal "Firstmate provenance is missing"
  [ -f "$FM_HOME/LICENSE" ] || fatal "vendored Firstmate license is missing"
  command -v node >/dev/null 2>&1 || fatal "required dependency not found: node"
  command -v git >/dev/null 2>&1 || fatal "required dependency not found: git"
  node - "$CLERKMESH_ROOT/firstmate.provenance.json" <<'NODE' || fatal "Firstmate provenance is invalid"
const crypto = require('crypto');
const fs = require('fs');
const path = require('path');
const provenancePath = process.argv[2];
const p = JSON.parse(fs.readFileSync(provenancePath, 'utf8'));
for (const key of ['repository', 'defaultBranch', 'sourceCommit', 'sourceTree', 'vendoredAt', 'vendoredPath', 'license', 'licenseFile', 'licenseSha256', 'attribution']) {
  if (typeof p[key] !== 'string' || !p[key]) process.exit(1);
}
if (!/^[0-9a-f]{40}$/.test(p.sourceCommit) || !/^[0-9a-f]{40}$/.test(p.sourceTree) ||
    !/^[0-9a-f]{64}$/.test(p.licenseSha256) || p.vendoredPath !== 'firstmate' ||
    p.licenseFile !== 'firstmate/LICENSE' || p.license !== 'MIT' ||
    p.vendoring?.method !== 'copy' || !Array.isArray(p.vendoring.excluded) ||
    p.vendoring.excluded.length !== 1 || p.vendoring.excluded[0] !== '.git' ||
    !/^[0-9a-f]{40}$/.test(p.vendoring.clerkMeshImportCommit || '')) process.exit(1);
const root = path.dirname(provenancePath);
const licensePath = path.resolve(root, p.licenseFile);
if (licensePath !== path.join(root, 'firstmate', 'LICENSE')) process.exit(1);
const digest = crypto.createHash('sha256').update(fs.readFileSync(licensePath)).digest('hex');
if (digest !== p.licenseSha256) process.exit(1);
NODE
}

has_entries() { [ -d "$1" ] && [ -n "$(find "$1" -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null)" ]; }
path_exists() { [ -e "$1" ] || [ -L "$1" ]; }

emit_escalation_clerk() {
  cat <<'EOF'
---
name: escalation
description: >-
  Captain-executed work explicitly accepted when no specialist Clerk can safely cover the request; never selected automatically.
execution: human
---

# Role
Handle work only when the Captain explicitly chooses to take it over.

# Capabilities
Record Captain-executed outcomes for an explicitly selected execution.

# Boundaries
Never match requests automatically, spawn a Worker, or act as a generalist.

# Working Style
Keep the Captain's evidence and decisions explicit.

# Instructions
Wait for explicit Captain selection before every execution.

# Context
No additional capability material is available.
EOF
}

emit_research_clerk() {
  cat <<'EOF'
---
name: research
description: >-
  Source-backed investigation across public documentation, repositories, and the web when no more specialized Clerk completely matches.
execution: agent
---

# Role
Produce bounded, source-backed research that answers the Task's stated questions.

# Capabilities
Search public sources, inspect public repositories and documentation, compare evidence, identify uncertainty, and write a concise research report with citations.

# Boundaries
Do not implement, modify Project content, design the final product, make Captain decisions, handle credentials, or claim expertise not supported by sources. Yield to any active specialist Clerk that completely matches the work.

# Working Style
Start from the exact research questions, prefer primary sources, distinguish evidence from inference, record URLs and access dates, and report gaps rather than guessing.

# Instructions
Use only tools available to the Worker. Keep collection proportional to the Task, cross-check consequential claims, and finish with findings, sources, uncertainties, and recommended next questions.

# Context
No bundled domain knowledge is provided; use current authoritative sources for each execution.
EOF
}

emit_registry_legacy() {
  printf '# Clerk registry v1\n\n| name | path | status | built-in |\n|---|---|---|---|\n| escalation | %s | active | true |\n' "$CLERKMESH_CLERKS/escalation"
}

emit_registry() {
  emit_registry_legacy
  printf '| research | %s | active | true |\n' "$CLERKMESH_CLERKS/research"
}

validate_registry_layout() {
  registry=$1
  expected_header=$(printf '# Clerk registry v1\n\n| name | path | status | built-in |\n|---|---|---|---|')
  actual_header=$(head -n 4 "$registry" 2>/dev/null) || return 1
  [ "$actual_header" = "$expected_header" ] || return 1
  escalation_row="| escalation | $CLERKMESH_CLERKS/escalation | active | true |"
  [ "$(grep -Fxc "$escalation_row" "$registry" 2>/dev/null)" = 1 ] || return 1
  research_row="| research | $CLERKMESH_CLERKS/research | active | true |"
  research_count=$(grep -Fxc "$research_row" "$registry" 2>/dev/null || true)
  [ "$research_count" = 0 ] || [ "$research_count" = 1 ] || return 1
  tail -n +5 "$registry" | while IFS= read -r row; do
    [ "$row" = "$escalation_row" ] || [ "$row" = "$research_row" ] || \
      printf '%s\n' "$row" | grep -Eq '^\| [a-z0-9]+(-[a-z0-9]+)* \| /[^|]+ \| (active|archived) \| false \|$' || exit 1
  done
}

validate_state_directories() {
  for path in "$CLERKMESH_DATA" "$CLERKMESH_STATE" "$CLERKMESH_CLERKS" "$CLERKMESH_CACHE" \
    "$FM_HOME/data" "$FM_HOME/state" "$FM_HOME/projects"; do
    if path_exists "$path" && { [ ! -d "$path" ] || [ -L "$path" ]; }; then
      fatal "nonconforming existing state path (expected a directory): $path"
    fi
  done
}

validate_escalation() {
  escalation="$CLERKMESH_CLERKS/escalation"
  [ -d "$escalation" ] && [ ! -L "$escalation" ] || \
    fatal "conflicting current-version Escalation Clerk at $escalation"
  [ -d "$escalation/.git" ] && [ ! -L "$escalation/.git" ] || \
    fatal "conflicting current-version Escalation Clerk at $escalation"
  [ -f "$escalation/CLERK.md" ] && [ ! -L "$escalation/CLERK.md" ] || \
    fatal "conflicting current-version Escalation Clerk at $escalation"
  emit_escalation_clerk | cmp -s - "$escalation/CLERK.md" || \
    fatal "conflicting current-version Escalation Clerk at $escalation"

  git_top=$(GIT_OPTIONAL_LOCKS=0 git -C "$escalation" rev-parse --show-toplevel 2>/dev/null) || \
    fatal "conflicting current-version Escalation Clerk at $escalation"
  [ "$git_top" = "$escalation" ] || fatal "conflicting current-version Escalation Clerk at $escalation"
  [ "$(GIT_OPTIONAL_LOCKS=0 git -C "$escalation" symbolic-ref --short HEAD 2>/dev/null)" = main ] || \
    fatal "conflicting current-version Escalation Clerk at $escalation"
  [ "$(GIT_OPTIONAL_LOCKS=0 git -C "$escalation" rev-list --count HEAD 2>/dev/null)" = 1 ] || \
    fatal "conflicting current-version Escalation Clerk at $escalation"
  [ "$(GIT_OPTIONAL_LOCKS=0 git -C "$escalation" ls-tree -r --name-only HEAD 2>/dev/null)" = CLERK.md ] || \
    fatal "conflicting current-version Escalation Clerk at $escalation"
  expected_blob=$(emit_escalation_clerk | git hash-object --stdin)
  [ "$(GIT_OPTIONAL_LOCKS=0 git -C "$escalation" rev-parse HEAD:CLERK.md 2>/dev/null)" = "$expected_blob" ] || \
    fatal "conflicting current-version Escalation Clerk at $escalation"
  [ -z "$(GIT_OPTIONAL_LOCKS=0 git -C "$escalation" status --porcelain --untracked-files=all 2>/dev/null)" ] || \
    fatal "conflicting current-version Escalation Clerk at $escalation"
}

validate_research() {
  research="$CLERKMESH_CLERKS/research"
  [ -d "$research" ] && [ ! -L "$research" ] && [ -d "$research/.git" ] && [ ! -L "$research/.git" ] && \
    [ -f "$research/CLERK.md" ] && [ ! -L "$research/CLERK.md" ] || \
    fatal "conflicting current-version Research Clerk at $research"
  emit_research_clerk | cmp -s - "$research/CLERK.md" || fatal "conflicting current-version Research Clerk at $research"
  [ "$(GIT_OPTIONAL_LOCKS=0 git -C "$research" rev-list --count HEAD 2>/dev/null)" = 1 ] && \
    [ "$(GIT_OPTIONAL_LOCKS=0 git -C "$research" symbolic-ref --short HEAD 2>/dev/null)" = main ] && \
    [ "$(GIT_OPTIONAL_LOCKS=0 git -C "$research" ls-tree -r --name-only HEAD 2>/dev/null)" = CLERK.md ] && \
    [ "$(GIT_OPTIONAL_LOCKS=0 git -C "$research" rev-parse HEAD:CLERK.md 2>/dev/null)" = "$(emit_research_clerk | git hash-object --stdin)" ] && \
    [ -z "$(GIT_OPTIONAL_LOCKS=0 git -C "$research" status --porcelain --untracked-files=all 2>/dev/null)" ] || \
    fatal "conflicting current-version Research Clerk at $research"
}

preflight_init_state() {
  validate_state_directories
  marker="$CLERKMESH_DATA/.clerkmesh-version"
  if ! path_exists "$marker"; then
    for path in "$CLERKMESH_DATA" "$CLERKMESH_STATE" "$CLERKMESH_CLERKS" "$CLERKMESH_CACHE" \
      "$FM_HOME/data" "$FM_HOME/state" "$FM_HOME/projects"; do
      has_entries "$path" && fatal "unknown existing ClerkMesh state at $path"
    done
    return 0
  fi

  [ -f "$marker" ] && [ ! -L "$marker" ] || fatal "nonconforming ClerkMesh state version marker"
  printf '%s\n' "$VERSION" | cmp -s - "$marker" || fatal "unsupported or malformed ClerkMesh state version"

  registry="$CLERKMESH_DATA/clerks.md"
  if path_exists "$registry"; then
    if [ ! -f "$registry" ] || [ -L "$registry" ] || ! validate_registry_layout "$registry"; then
      fatal "conflicting current-version Clerk registry at $registry"
    fi
  fi

  escalation="$CLERKMESH_CLERKS/escalation"
  if path_exists "$escalation"; then validate_escalation; fi
  research="$CLERKMESH_CLERKS/research"
  if path_exists "$research"; then validate_research; fi
}

init() {
  verify_provenance
  preflight_init_state

  mkdir -p "$CLERKMESH_DATA" "$CLERKMESH_STATE" "$CLERKMESH_CLERKS" "$CLERKMESH_CACHE" \
    "$FM_HOME/data" "$FM_HOME/state" "$FM_HOME/projects"
  for path in "$CLERKMESH_DATA" "$CLERKMESH_STATE" "$CLERKMESH_CLERKS" "$CLERKMESH_CACHE" \
    "$FM_HOME/data" "$FM_HOME/state" "$FM_HOME/projects"; do
    [ -w "$path" ] || fatal "directory is not writable: $path"
  done

  escalation="$CLERKMESH_CLERKS/escalation"
  if ! path_exists "$escalation"; then
    mkdir -p "$escalation"
    emit_escalation_clerk > "$escalation/CLERK.md"
    git -C "$escalation" init -q -b main
    git -C "$escalation" config user.name "ClerkMesh"
    git -C "$escalation" config user.email "clerkmesh@localhost"
    git -C "$escalation" add CLERK.md
    git -C "$escalation" commit -q -m "Initialize built-in Escalation Clerk"
  fi

  research="$CLERKMESH_CLERKS/research"
  if ! path_exists "$research"; then
    mkdir -p "$research"
    emit_research_clerk > "$research/CLERK.md"
    git -C "$research" init -q -b main
    git -C "$research" config user.name "ClerkMesh"
    git -C "$research" config user.email "clerkmesh@localhost"
    git -C "$research" add CLERK.md
    git -C "$research" commit -q -m "Initialize built-in Research Clerk"
  fi

  registry="$CLERKMESH_DATA/clerks.md"
  if ! path_exists "$registry"; then
    emit_registry > "$registry"
  elif ! grep -Fq "| research | $CLERKMESH_CLERKS/research | active | true |" "$registry"; then
    printf '| research | %s | active | true |\n' "$CLERKMESH_CLERKS/research" >> "$registry"
  fi
  marker="$CLERKMESH_DATA/.clerkmesh-version"
  if ! path_exists "$marker"; then
    printf '%s\n' "$VERSION" > "$marker"
  fi
  printf 'ClerkMesh initialized at %s\n' "$CLERKMESH_ROOT"
}

require_initialized() {
  marker="$CLERKMESH_DATA/.clerkmesh-version"
  [ -f "$marker" ] && [ ! -L "$marker" ] || fatal "ClerkMesh is not initialized; run bin/clerkmesh init first"
  verify_provenance
  preflight_init_state
  for path in "$CLERKMESH_DATA" "$CLERKMESH_STATE" "$CLERKMESH_CLERKS" "$CLERKMESH_CACHE" \
    "$FM_HOME/data" "$FM_HOME/state" "$FM_HOME/projects"; do
    [ -d "$path" ] && [ ! -L "$path" ] || fatal "incomplete initialized state at $path; run bin/clerkmesh init"
  done
  [ -f "$CLERKMESH_DATA/clerks.md" ] && [ ! -L "$CLERKMESH_DATA/clerks.md" ] || \
    fatal "incomplete initialized Clerk registry; run bin/clerkmesh init"
  path_exists "$CLERKMESH_CLERKS/escalation" || fatal "incomplete initialized Escalation Clerk; run bin/clerkmesh init"
  path_exists "$CLERKMESH_CLERKS/research" || fatal "incomplete initialized Research Clerk; run bin/clerkmesh init"
  validate_escalation
  validate_research
}

launch_primary_tui() {
  require_initialized
  exec node "$CLERKMESH_ROOT/packages/shared/src/primary-launch.mjs" tui
}

launch_web() {
  require_initialized
  exec node "$CLERKMESH_ROOT/apps/web/server/src/conversation-main.mjs"
}

launch_gate0_web() {
  require_initialized
  exec node "$CLERKMESH_ROOT/apps/web/server/gate0-cert-server.mjs"
}

import_learning_source() {
  require_initialized
  shift
  exec node "$CLERKMESH_ROOT/packages/learning-core/src/learning-source-import-cli.mjs" "$@"
}

extract_learning_proposal() {
  require_initialized
  shift
  exec node "$CLERKMESH_ROOT/packages/learning-core/src/learning-extraction-cli.mjs" "$@"
}

reconcile_learning_proposal() {
  require_initialized
  shift
  exec node "$CLERKMESH_ROOT/packages/learning-core/src/learning-reconciliation-cli.mjs" "$@"
}

case "${1:-}" in
  init)
    [ "$#" -eq 1 ] || fatal "usage: clerkmesh init"
    init
    ;;
  primary)
    [ "$#" -eq 2 ] && [ "${2:-}" = --tui ] || fatal "usage: clerkmesh primary --tui"
    launch_primary_tui
    ;;
  web)
    if [ "$#" -eq 1 ]; then
      launch_web
    elif [ "$#" -eq 2 ] && [ "${2:-}" = --gate0-cert ]; then
      launch_gate0_web
    else
      fatal "usage: clerkmesh web [--gate0-cert]"
    fi
    ;;
  learning-source)
    [ "${2:-}" = import ] || fatal "usage: clerkmesh learning-source import [--agent-generated] FILE"
    shift
    import_learning_source "$@"
    ;;
  learning-proposal)
    case "${2:-}" in
      extract)
        shift
        extract_learning_proposal "$@"
        ;;
      reconcile)
        shift
        reconcile_learning_proposal "$@"
        ;;
      *) fatal "usage: clerkmesh learning-proposal extract PROPOSAL_ID --session HERDR_SESSION | clerkmesh learning-proposal reconcile PROPOSAL_ID" ;;
    esac
    ;;
  *) fatal "usage: clerkmesh init | primary --tui | web [--gate0-cert] | learning-source import [--agent-generated] FILE | learning-proposal extract PROPOSAL_ID --session HERDR_SESSION | learning-proposal reconcile PROPOSAL_ID" ;;
esac
