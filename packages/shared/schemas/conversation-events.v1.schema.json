{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clerkmesh.local/schemas/conversation-events.v1.schema.json",
  "title": "ClerkMesh conversation event snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "observedAt", "freshness", "provenance", "cursor", "events", "omitted", "errors"],
  "properties": {
    "schema": { "const": "clerkmesh.conversation-events.v1" },
    "observedAt": { "type": "string", "format": "date-time" },
    "freshness": { "enum": ["current", "unknown"] },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "projection"],
      "properties": {
        "authority": { "const": "pi-session-jsonl" },
        "projection": { "const": "process-local-pi-rpc-events" }
      }
    },
    "cursor": { "type": "integer", "minimum": 0 },
    "events": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/event" }
    },
    "omitted": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reason"],
        "properties": { "reason": { "type": "string", "minLength": 1 } }
      }
    },
    "errors": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "kind", "payload"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "kind": {
          "enum": ["visible-message", "stream-fragment", "notification", "error", "primary-status", "extension-ui", "diagnostic"]
        },
        "payload": { "type": "object" }
      }
    }
  }
}
