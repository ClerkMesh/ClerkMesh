{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clerkmesh.local/schemas/conversation-sessions.v1.schema.json",
  "title": "ClerkMesh conversation session catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "observedAt", "freshness", "provenance", "sessions", "omitted", "errors"],
  "properties": {
    "schema": { "const": "clerkmesh.conversation-sessions.v1" },
    "observedAt": { "type": "string", "format": "date-time" },
    "freshness": { "enum": ["current", "unknown"] },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority"],
      "properties": { "authority": { "const": "pi-session-jsonl" } }
    },
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "createdAt", "modifiedAt", "messageCount"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": ["string", "null"] },
          "createdAt": { "type": "string", "format": "date-time" },
          "modifiedAt": { "type": "string", "format": "date-time" },
          "messageCount": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "omitted": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reason"],
        "properties": { "reason": { "type": "string", "minLength": 1 } }
      }
    },
    "errors": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
