{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clerkmesh.local/schemas/clerk-catalog.v1.schema.json",
  "title": "Clerk catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "observedAt", "freshness", "provenance", "clerks", "omitted", "errors"],
  "properties": {
    "schema": { "const": "clerk-catalog.v1" },
    "observedAt": { "type": "string", "format": "date-time" },
    "freshness": { "enum": ["current", "unknown"] },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registrySchema"],
      "properties": {
        "registrySchema": { "const": "clerk-registry.v1" }
      }
    },
    "clerks": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "builtIn", "execution", "approvedCommit", "description"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 100 },
          "status": { "enum": ["active", "archived"] },
          "builtIn": { "type": "boolean" },
          "execution": { "enum": ["agent", "human"] },
          "approvedCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "description": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    },
    "omitted": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "reason"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 100 },
          "reason": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    },
    "errors": {
      "type": "array",
      "maxItems": 10000,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    }
  }
}
